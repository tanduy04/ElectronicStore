      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1-Preview.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElectronicStore.WebApi.Application\ElectronicStore.WebApi.Application.csproj" />
    <ProjectReference Include="..\ElectronicStore.WebApi.Domain\ElectronicStore.WebApi.Domain.csproj" />
    <ProjectReference Include="..\ElectronicStore.WebApi.Infrastructure\ElectronicStore.WebApi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
